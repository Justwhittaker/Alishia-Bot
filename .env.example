# Optional: add API keys or bot tokens here
# BOT_TOKEN=

# Shopify Admin MCP (custom app Admin API access token)
# Settings → Apps → Develop apps → Create app → Configure Admin API scopes
# Suggested scopes: read_products, write_products, read_orders, read_customers
# (write_products required for shopify_import_products_csv / shop import --apply)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxx
# SHOPIFY_API_VERSION=2025-10
